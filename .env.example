# Copy to .env for local development. Never put real credentials or patient data here.
CAREBRIDGE_ENV=local
CAREBRIDGE_DB_URL=jdbc:postgresql://localhost:5432/carebridge
CAREBRIDGE_DB_USER=carebridge
CAREBRIDGE_DB_PASSWORD=change-me-local-only
CAREBRIDGE_REDIS_HOST=localhost
CAREBRIDGE_REDIS_PORT=6379
CAREBRIDGE_API_PORT=8080
# mock = recorded synthetic responses, no credentials needed
AI_PROVIDER=mock
# Demo accounts: load care units, accounts and memberships from the synthetic seed on startup.
# Every demo account signs in with CAREBRIDGE_DEMO_PASSWORD. Choose your own value (at least
# 12 characters); the API refuses to seed while it is empty or still starts with "change-me".
CAREBRIDGE_DEMO_SEED=true
CAREBRIDGE_DEMO_PASSWORD=
# Set to true when the API is served over HTTPS
CAREBRIDGE_SECURE_COOKIES=false
