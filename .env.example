# Copy to .env for local development. Never put real credentials or patient data here.
CAREBRIDGE_ENV=local
CAREBRIDGE_DB_URL=jdbc:postgresql://localhost:5432/carebridge
CAREBRIDGE_DB_USER=carebridge
CAREBRIDGE_DB_PASSWORD=change-me-local-only
CAREBRIDGE_REDIS_HOST=localhost
CAREBRIDGE_REDIS_PORT=6379
CAREBRIDGE_API_PORT=8080
# mock = recorded synthetic responses, no credentials needed
AI_PROVIDER=mock
